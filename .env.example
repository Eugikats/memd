# Business Central (Entra ID app registration, read-only API permissions)
BC_TENANT_ID=
BC_ENVIRONMENT=NHOP-TEST
BC_COMPANY_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_SCOPE=https://api.businesscentral.dynamics.com/.default
# Azure OpenAI deployment. Local development can authenticate with `az login`;
# hosted deployments should use a managed identity with Cognitive Services OpenAI User.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_KEY=
